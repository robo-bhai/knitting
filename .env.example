# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ================= DATABASE CONFIGURATION =================
# Set DB_TYPE to 'mysql' to use MySQL (local, Termux, or cloud like Aiven, TiDB, PlanetScale, Railway)
# Set DB_TYPE to 'sqlite' (or leave unset) to use local SQLite database file
DB_TYPE="mysql"

# MySQL Host (e.g., 127.0.0.1, mysql.railway.internal, gateway01.us-east-1.prod.aws.tidbcloud.com)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DB="garmentflow_pro"
MYSQL_SSL="false"

# SQLite Fallback (used when DB_TYPE=sqlite or MySQL connection fails)
SQLITE_DB="database.db"

# Flask Secret Key
SECRET_KEY="super_secret_garmentflow_key_change_in_production"
